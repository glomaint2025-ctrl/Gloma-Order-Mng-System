# Gloma Shop Portal — copy to .env and fill in. Secrets live ONLY in .env (never in git).
APP_NAME="Gloma Shop Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Colombo
APP_VERSION=dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Local: sqlite works out of the box. UAT/production: mysql (same major version everywhere).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gloma_portal
# DB_USERNAME=
# DB_PASSWORD=

# Sanctum SPA (same domain). Production example: SANCTUM_STATEFUL_DOMAINS=portal.example.lk
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000,127.0.0.1,127.0.0.1:8000
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Shared hosting: database queue + cache, worker via cron (docs/08-OPERATIONS.md). VPS later: redis.
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Transactional email provider with SPF/DKIM (not the shared host's mail). Local: log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.lk"
MAIL_FROM_NAME="${APP_NAME}"

# SMS: log (dev) | textlk (UAT/production)
SMS_DRIVER=log
SMS_COST_PER_SEGMENT=0.64
TEXTLK_BASE_URL=https://app.text.lk
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=

PORTAL_COMPANY_NAME="Gloma International"
PORTAL_PRIVACY_URL=
CUSTOMER_RETENTION_YEARS=5
LOW_STOCK_THRESHOLD=5

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
