 * Enable PDF/A-3 compliance mode
 *
 * ==== EXPERIMENTAL ====
 * This feature is currently only supported with the CPDF backend and will
 * have no effect if used with any other.
 *
 * Currently this mode only takes care of adding the necessary metadata, output intents, etc.
 * It does not enforce font embedding, it's up to you to embed the fonts you plan on using.
 *
 * @var bool
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:242;s:7:"endLine";i:242;s:11:"startColumn";i:5;s:9:"endColumn";i:35;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:19:"isJavascriptEnabled";a:16:{s:18:"declaringClassName";s:14:"Dompdf\Options";s:21:"implementingClassName";s:14:"Dompdf\Options";s:4:"name";s:19:"isJavascriptEnabled";s:9:"modifiers";i:4;s:4:"type";N;s:7:"default";a:2:{s:4:"code";s:4:"true";s:10:"attributes";a:6:{s:9:"startLine";i:256;s:7:"endLine";i:256;s:13:"startTokenPos";i:269;s:12:"startFilePos";i:8108;s:11:"endTokenPos";i:269;s:10:"endFilePos";i:8111;}}s:10:"docComment";s:368:"/**
