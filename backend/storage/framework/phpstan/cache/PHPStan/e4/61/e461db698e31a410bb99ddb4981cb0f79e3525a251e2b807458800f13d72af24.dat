 * Enable embedded PHP
 *
 * If this setting is set to true then DOMPDF will automatically evaluate
 * embedded PHP contained within <script type="text/php"> ... </script> tags.
 *
 * ==== IMPORTANT ====
 * Enabling this for documents you do not trust (e.g. arbitrary remote html
 * pages) is a security risk. Embedded scripts are run with the same level of
 * system access available to dompdf. Set this option to false (recommended)
 * if you wish to process untrusted documents.
 *
 * This setting may increase the risk of system exploit. Do not change
 * this settings without understanding the consequences. Additional
 * documentation is available on the dompdf wiki at:
 * https://github.com/dompdf/dompdf/wiki
 *
 * @var bool
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:192;s:7:"endLine";i:192;s:11:"startColumn";i:5;s:9:"endColumn";i:34;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:15:"isRemoteEnabled";a:16:{s:18:"declaringClassName";s:14:"Dompdf\Options";s:21:"implementingClassName";s:14:"Dompdf\Options";s:4:"name";s:15:"isRemoteEnabled";s:9:"modifiers";i:4;s:4:"type";N;s:7:"default";a:2:{s:4:"code";s:5:"false";s:10:"attributes";a:6:{s:9:"startLine";i:214;s:7:"endLine";i:214;s:13:"startTokenPos";i:236;s:12:"startFilePos";i:6753;s:11:"endTokenPos";i:236;s:10:"endFilePos";i:6757;}}s:10:"docComment";s:861:"/**
 * Enable remote file access
 *
 * If this setting is set to true, DOMPDF will access remote sites for
 * images and CSS files as required.
 *
 * ==== IMPORTANT ====
 * This can be a security risk, in particular in combination with isPhpEnabled and
 * allowing remote html code to be passed to $dompdf = new DOMPDF(); $dompdf->load_html(...);
 * This allows anonymous users to download legally doubtful internet content which on
 * tracing back appears to being downloaded by your server, or allows malicious php code
 * in remote html pages to be executed by your server with your account privileges.
 *
 * This setting may increase the risk of system exploit. Do not change
 * this settings without understanding the consequences. Additional
 * documentation is available on the dompdf wiki at:
 * https://github.com/dompdf/dompdf/wiki
 *
 * @var bool
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:214;s:7:"endLine";i:214;s:11:"startColumn";i:5;s:9:"endColumn";i:37;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:18:"allowedRemoteHosts";a:16:{s:18:"declaringClassName";s:14:"Dompdf\Options";s:21:"implementingClassName";s:14:"Dompdf\Options";s:4:"name";s:18:"allowedRemoteHosts";s:9:"modifiers";i:4;s:4:"type";N;s:7:"default";a:2:{s:4:"code";s:4:"null";s:10:"attributes";a:6:{s:9:"startLine";i:228;s:7:"endLine";i:228;s:13:"startTokenPos";i:247;s:12:"startFilePos";i:7171;s:11:"endTokenPos";i:247;s:10:"endFilePos";i:7174;}}s:10:"docComment";s:327:"/**
 * List of allowed remote hosts
 *
 * Each value of the array must be a valid hostname.
 *
 * This will be used to filter which resources can be loaded in combination with
 * isRemoteEnabled. If isRemoteEnabled is FALSE, then this will have no effect.
