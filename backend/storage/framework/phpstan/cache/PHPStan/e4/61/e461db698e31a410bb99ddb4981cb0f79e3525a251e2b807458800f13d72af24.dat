 * Image DPI setting
 *
 * This setting determines the default DPI setting for images and fonts.  The
 * DPI may be overridden for inline images by explicitly setting the
 * image's width & height style attributes (i.e. if the image's native
 * width is 600 pixels and you specify the image's width as 72 points,
 * the image will have a DPI of 600 in the rendered PDF.  The DPI of
 * background images can not be overridden and is controlled entirely
 * via this parameter.
 *
 * For the purposes of DOMPDF, pixels per inch (PPI) = dots per inch (DPI).
 * If a size in html is given as px (or without unit as image size),
 * this tells the corresponding size in pt at 72 DPI.
 * This adjusts the relative sizes to be similar to the rendering of the
 * html page in a reference browser.
 *
 * In pdf, always 1 pt = 1/72 inch
 *
 * @var int
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:157;s:7:"endLine";i:157;s:11:"startColumn";i:5;s:9:"endColumn";i:22;s:10:"isPromoted";b:0;s:21:"declaredAtCompileTime";b:1;s:16:"immediateVirtual";b:0;s:14:"immediateHooks";a:0:{}}s:15:"fontHeightRatio";a:16:{s:18:"declaringClassName";s:14:"Dompdf\Options";s:21:"implementingClassName";s:14:"Dompdf\Options";s:4:"name";s:15:"fontHeightRatio";s:9:"modifiers";i:4;s:4:"type";N;s:7:"default";a:2:{s:4:"code";s:3:"1.1";s:10:"attributes";a:6:{s:9:"startLine";i:164;s:7:"endLine";i:164;s:13:"startTokenPos";i:202;s:12:"startFilePos";i:4752;s:11:"endTokenPos";i:202;s:10:"endFilePos";i:4754;}}s:10:"docComment";s:101:"/**
