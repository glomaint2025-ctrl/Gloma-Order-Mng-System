 * Alter the timestamp of a DateTime object by incrementing or decrementing
 * in a format accepted by strtotime().
 * @param string $modifier A date/time string. Valid formats are explained in <a href="https://secure.php.net/manual/en/datetime.formats.php">Date and Time Formats</a>.
 * @return static|false Returns the DateTime object for method chaining or FALSE on failure.
 * @link https://php.net/manual/en/datetime.modify.php
 * @betterReflectionTentativeReturnType
 */";s:9:"startLine";i:130;s:7:"endLine";i:138;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:8:"DateTime";s:21:"implementingClassName";s:8:"DateTime";s:16:"currentClassName";s:8:"DateTime";s:9:"aliasName";N;}s:3:"add";a:20:{s:4:"name";s:3:"add";s:10:"parameters";a:1:{s:8:"interval";a:13:{s:4:"name";s:8:"interval";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:12:"DateInterval";s:12:"isIdentifier";b:0;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:147;s:7:"endLine";i:147;s:11:"startColumn";i:29;s:9:"endColumn";i:51;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:8:"DateTime";s:12:"isIdentifier";b:0;}}s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:41:"JetBrains\PhpStorm\Internal\TentativeType";s:10:"isRepeated";b:0;s:9:"arguments";a:0:{}}}s:10:"docComment";s:320:"/**
