O:23:"PHPStan\Cache\CacheItem":2:{s:11:"variableKey";s:38:"v3-6.73.0.6-dev-master@e4f5f6c-8.2.12-";s:4:"data";a:22:{s:13:"locatedSource";a:2:{s:5:"class";s:68:"PHPStan\BetterReflection\SourceLocator\Located\InternalLocatedSource";s:4:"data";a:4:{s:4:"name";s:17:"DateTimeImmutable";s:8:"filename";s:31:"phpstorm-stubs:date/date_c.stub";s:13:"extensionName";s:4:"date";s:9:"aliasName";N;}}s:9:"namespace";N;s:4:"name";s:17:"DateTimeImmutable";s:9:"shortName";s:17:"DateTimeImmutable";s:11:"isInterface";b:0;s:7:"isTrait";b:0;s:6:"isEnum";b:0;s:12:"isBackedEnum";b:0;s:9:"modifiers";i:0;s:10:"docComment";s:267:"/**
